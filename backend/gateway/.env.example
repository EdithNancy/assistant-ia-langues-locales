# Variables for running the Gateway directly on the host.
# The Gateway reads JWT_SECRET_KEY, JWT_ALGORITHM, and JWT_AUDIENCE from
# ../.env (shared) before falling back to ../identity/.env.
# Process environment variables take precedence over both files.
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=
JWT_AUDIENCE=
IDENTITY_URL=http://127.0.0.1:8001
CONVERSATION_URL=http://127.0.0.1:8002
LEARNING_URL=http://127.0.0.1:8003
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
RATE_LIMIT=120
RATE_WINDOW=60
CORS_ORIGINS=http://localhost:3000,http://192.168.252.23:3000
UPSTREAM_TIMEOUT=30
OTEL_EXPORTER_OTLP_ENDPOINT=
