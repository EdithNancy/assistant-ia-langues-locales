# Variables for running the Gateway directly on the host.
JWT_ALGORITHM=HS256
JWT_KEY=REPLACE_WITH_THE_SAME_PRIVATE_RANDOM_SECRET_USED_BY_IDENTITY
JWT_AUDIENCE=
IDENTITY_URL=http://127.0.0.1:8001
