# Compose development secrets: replace every CHANGE_ME value before starting.
# Use URL-safe random values (letters, digits, underscore, hyphen) for passwords.
JWT_SECRET_KEY=CHANGE_ME_use_a_private_random_secret_of_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

IDENTITY_DB_USER=app
IDENTITY_DB_PASSWORD=CHANGE_ME_identity_db_url_safe_password
CONVERSATION_DB_USER=app
CONVERSATION_DB_PASSWORD=CHANGE_ME_conversation_db_url_safe_password
LEARNING_DB_USER=app
LEARNING_DB_PASSWORD=CHANGE_ME_learning_db_url_safe_password
REDIS_PASSWORD=CHANGE_ME_redis_url_safe_password

GATEWAY_HOST_BIND=127.0.0.1
GATEWAY_TRUSTED_PROXIES=127.0.0.1
GATEWAY_CORS_ORIGINS=http://localhost:5173
IDENTITY_CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT=120
RATE_WINDOW=60
UPSTREAM_TIMEOUT=30

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
