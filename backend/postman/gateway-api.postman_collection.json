      "name": "Authentification",
      "item": [
        {
          "name": "Register - créer un utilisateur de test",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12);",
                  "pm.collectionVariables.set('testEmail', `gateway.${id}@example.com`);",
                  "pm.collectionVariables.set('testPhone', `+22501${Date.now().toString().slice(-8)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inscription créée (HTTP 201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('La réponse contient le profil créé', function () {",
                  "    const body = pm.response.json().item;",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('email', pm.collectionVariables.get('testEmail'));",
                  "    pm.collectionVariables.set('userId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Utilisateur Postman\",\n  \"email\": \"{{testEmail}}\",\n  \"phone_number\": \"{{testPhone}}\",\n  \"password\": \"MotDePassePostman123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Crée un compte avec email et téléphone uniques générés juste avant l'envoi. L'API Gateway transmet la requête à Identity."
          },
          "response": []
