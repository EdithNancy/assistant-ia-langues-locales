APP_NAME="IA Langues Locales CI"
DEBUG=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ia_langues_locales
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_SOCIAL_NONCE=10/minute
JWT_SECRET_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
FREE_TOKEN_GRANT=1000
FREE_TOKEN_REFILL_DAYS=30
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
